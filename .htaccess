RewriteEngine On

# ============================================================
# HTTPS — Forzar conexión segura (solo en producción)
# ============================================================
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ============================================================
# CANONICAL — Redirige /pagina.html → /pagina
# Los enlaces internos usan .html para compatibilidad con
# Live Server local. Apache los redirige a URL limpia (301
# queda cacheado en el navegador, sin penalidad en visitas sucesivas).
# ============================================================
RewriteCond %{THE_REQUEST} \ /(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ============================================================
# URL limpias — Sirve /pagina desde pagina.html
# ============================================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# ============================================================
# Cabeceras de seguridad HTTP
# ============================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # CSP — incluye los CDN externos actualmente en uso.
    # Cuando las librerías pasen a lib/ local, eliminar los dominios CDN de cada directiva.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://code.jquery.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://maxcdn.bootstrapcdn.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://maxcdn.bootstrapcdn.com; img-src 'self' data: https:; connect-src 'self' https://api.whatsapp.com; form-action 'self'; frame-ancestors 'none';"
</IfModule>

# ============================================================
# Caché de activos estáticos
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg        "access plus 1 year"
    ExpiresByType image/png         "access plus 1 year"
    ExpiresByType image/webp        "access plus 1 year"
    ExpiresByType image/x-icon      "access plus 1 year"
    ExpiresByType text/css          "access plus 6 months"
    ExpiresByType application/javascript "access plus 6 months"
</IfModule>

# ============================================================
# Compresión GZIP
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript
</IfModule>

# ============================================================
# Bloquear acceso directo a archivos de configuración
# ============================================================
<FilesMatch "(^\.env|app_config.*\.php|composer\.(json|lock)|package\.json)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ============================================================
# Bloquear acceso directo a la librería vendorizada de PHPMailer
# (send_email.php la incluye internamente; no necesita ser
# accesible por URL, y exponerla facilita el fingerprinting
# de versión).
# ============================================================
RewriteRule ^PHPMailer/ - [F,L]
